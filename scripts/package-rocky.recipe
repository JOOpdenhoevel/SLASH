BootStrap: docker
From: rockylinux:9

%post
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf install -y \
        gcc gcc-c++ rpm-build cmake pkgconf ninja-build rsync git createrepo_c \
        python3.11 python3.11-pip python3-setuptools \
        cli11-devel cppzmq-devel inih-devel jsoncpp-devel libxml2-devel systemd-devel zeromq-devel zlib-devel

%environment
    export LC_ALL=C

%environment
    export SLASH_PKG_SKIP_ROOT_DESIGN_BUILD=1

%runscript
    ./scripts/package-rpm.sh
