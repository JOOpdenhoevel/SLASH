BootStrap: docker
From: ubuntu:22.04

%post
    apt update
    apt upgrade -y
    apt install -y cmake pkg-config ninja-build rsync git \
        dpkg-dev debhelper dkms python3 python3-pip apt-utils \
        libxml2-dev libzmq3-dev libjsoncpp-dev zlib1g-dev \
        libsystemd-dev libinih-dev libcli11-dev

%environment
    export LC_ALL=C

%environment
    export SLASH_PKG_SKIP_ROOT_DESIGN_BUILD=1

%runscript
    ./scripts/package-deb.sh
