BootStrap: docker
From: rockylinux:9

%files
    ./rpm/*.rpm

%post
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf install -y \
        gcc gcc-c++ cmake glibc-langpack-en ncurses-compat-libs \
        /rpm/slash-devel-0.1.0-1.el9.noarch.rpm \
        /rpm/slash-sim-emu-devel-0.1.0-1.el9.noarch.rpm \
        /rpm/slash-sim-emu-0.1.0-1.el9.noarch.rpm \
        /rpm/v80++-0.1.0-1.el9.x86_64.rpm \
        /rpm/libvrt-devel-0.1.0-1.el9.x86_64.rpm \
        /rpm/libvrt-0.1.0-1.el9.x86_64.rpm \
        /rpm/libslash-devel-0.1.0-1.el9.x86_64.rpm \
        /rpm/libslash-0.1.0-1.el9.x86_64.rpm \
        /rpm/libvrtd-devel-0.1.0-1.el9.x86_64.rpm \
        /rpm/libvrtd-0.1.0-1.el9.x86_64.rpm \

%environment
    export TZ="Europe/Dublin"
    export LC_ALL=en_US
