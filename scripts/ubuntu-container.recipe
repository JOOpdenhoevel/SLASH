BootStrap: docker
From: ubuntu:22.04

%files
    ./deb/*.deb

%post
    apt update
    apt upgrade -y
    DEBIAN_FRONTEND=noninteractive apt install -y \
        cmake gcc g++ pkg-config locales-all libtinfo5 \
        /deb/slash-dev_*.deb \
        /deb/slash-sim-emu-dev_*.deb \
        /deb/slash-sim-emu_*.deb \
        /deb/v80++_*.deb \
        /deb/libvrt-dev_*.deb \
        /deb/libvrt_*.deb \
        /deb/libslash-dev_*.deb \
        /deb/libslash_*.deb \
        /deb/libvrtd-dev*.deb \
        /deb/libvrtd*.deb

%environment
    export TZ="Europe/Dublin"
    export LC_ALL=en_US
